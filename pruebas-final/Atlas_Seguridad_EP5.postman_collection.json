    {
      "name": "CP-22 Inyeccion SQL y XSS (NFR-SEG-5)",
      "item": [
        {
          "name": "CP-22a SQLi en login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/autenticacion/login",
            "body": {
              "mode": "raw",
              "raw": "{\"nombre_usuario\": \"' OR '1'='1\", \"password\": \"' OR '1'='1\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CP-22a: SQLi en login rechazado (401)',()=>pm.response.to.have.status(401));",
                  "pm.test('CP-22a: no se emite token',()=>pm.expect(pm.response.json().token).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-22b SQLi en buscador de clientes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/clientes/search?name=%27%3B%20DROP%20TABLE%20clientes%3B--"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CP-22b: sin error de servidor (no 500)',()=>pm.expect(pm.response.code).to.be.below(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-22c XSS almacenado en nombre de cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\": \"<script>alert(1)</script>\", \"correo\": \"qa@test.cl\", \"telefono\": \"912345678\", \"direccion\": \"Calle 1 123\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j={};try{j=pm.response.json()}catch(e){}",
                  "if(j.id)pm.collectionVariables.set('clienteXss',j.id);",
                  "pm.test('CP-22c: entrada con script rechazada o saneada (400)',()=>pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cleanup: elimina cliente XSS",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/clientes/{{clienteXss}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cleanup ejecutado',()=>pm.expect([200,404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}