  "item": [
    {
      "name": "CP-01 Autenticacion (RF-1.1)",
      "item": [
        {
          "name": "CP-01a Login valido admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/autenticacion/login",
            "body": {
              "mode": "raw",
              "raw": "{\"nombre_usuario\": \"{{adminUser}}\", \"password\": \"{{adminPass}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CP-01a: login valido responde 200',()=>pm.response.to.have.status(200));",
                  "pm.test('CP-01a: entrega token JWT',()=>{const j=pm.response.json();pm.expect(j.token).to.be.a('string');pm.collectionVariables.set('adminToken',j.token);});",
                  "pm.test('CP-01a/NFR-PERF-1: respuesta < 300 ms',()=>pm.expect(pm.response.responseTime).to.be.below(300));"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-01b Contrasena incorrecta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/autenticacion/login",
            "body": {
              "mode": "raw",
              "raw": "{\"nombre_usuario\": \"{{adminUser}}\", \"password\": \"incorrecta\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CP-01b: rechaza con 401',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-01c Usuario inexistente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/autenticacion/login",
            "body": {
              "mode": "raw",
              "raw": "{\"nombre_usuario\": \"noexiste\", \"password\": \"x\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CP-01c: rechaza con 401',()=>pm.response.to.have.status(401));",
                  "pm.test('CP-01c: mensaje generico (no revela si existe el usuario)',()=>pm.expect(pm.response.json().error).to.eql('Credenciales invalidas'.replace('invalidas','inválidas')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup: login editor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/autenticacion/login",
            "body": {
              "mode": "raw",
              "raw": "{\"nombre_usuario\": \"{{editorUser}}\", \"password\": \"{{editorPass}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Setup: login editor 200',()=>{pm.response.to.have.status(200);pm.collectionVariables.set('editorToken',pm.response.json().token);});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "CP-02 Logout y revocacion (RF-1.2, NFR-SEG-9)",
      "item": [
        {
          "name": "Setup: token para logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/autenticacion/login",
            "body": {
              "mode": "raw",
              "raw": "{\"nombre_usuario\": \"{{adminUser}}\", \"password\": \"{{adminPass}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Setup: login 200',()=>{pm.response.to.have.status(200);pm.collectionVariables.set('logoutToken',pm.response.json().token);});"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-02a Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{logoutToken}}"
              }
            ],
            "url": "{{baseUrl}}/autenticacion/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CP-02a: existe endpoint de logout (200/204)',()=>pm.expect([200,204]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-02b Reutilizar token tras logout",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{logoutToken}}"
              }
            ],
            "url": "{{baseUrl}}/clientes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CP-02b: token revocado es rechazado (401)',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
